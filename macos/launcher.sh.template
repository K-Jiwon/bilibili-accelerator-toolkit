#!/bin/zsh
# Generated by macos/install.sh - do not edit the copy inside the app bundle.
set -u

PORT=__PORT__
DIR="__DIR__"
BILI_APP="__BILI_APP__"
MAIN_BIN="$BILI_APP/Contents/MacOS/哔哩哔哩"
PY="__PYTHON__"
INJ="$DIR/injector.py"
SCRIPT="$DIR/bilibili-accelerator.user.js"
LOG="$DIR/injector.log"

mkdir -p "$DIR"

if ! pgrep -f "$INJ" >/dev/null 2>&1; then
  nohup "$PY" "$INJ" --port "$PORT" --script "$SCRIPT" --logfile "$LOG" \
    >> "$DIR/injector.stdout.log" 2>&1 &
fi

port_up() {
  curl -s --max-time 1 "http://127.0.0.1:$PORT/json/version" >/dev/null 2>&1
}

if port_up; then
  open -a "$BILI_APP"
  exit 0
fi

if pgrep -f "$MAIN_BIN" >/dev/null 2>&1; then
  pkill -TERM -f "$MAIN_BIN" >/dev/null 2>&1
  for _ in {1..20}; do
    pgrep -f "$MAIN_BIN" >/dev/null 2>&1 || break
    sleep 0.5
  done
fi

open -a "$BILI_APP" --args --remote-debugging-port="$PORT"

launched=0
for _ in {1..30}; do
  if port_up; then
    launched=1
    break
  fi
  sleep 0.5
done

if [ "$launched" = "1" ]; then
  osascript -e 'display notification "加速已启用" with title "哔哩哔哩"' >/dev/null 2>&1 &
else
  osascript -e 'display notification "未能开启调试端口，请查看 injector.log" with title "哔哩哔哩"' >/dev/null 2>&1 &
fi
